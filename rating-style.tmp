.rating-page {
    width:100%;
    max-width:600px;
    margin:auto;
    padding:20px;
}

.rating-intro {
    margin:25px 0;
}

.rating-intro h2 {
    font-size:22px;
    margin-bottom:8px;
}

.rating-intro p {
    color:rgba(255,255,255,.7);
    font-size:14px;
    line-height:1.5;
}

.platform-section {
    display:grid;
    gap:12px;
    margin:25px 0;
}

.platform-button {
    width:100%;
    padding:14px;
    border:1px solid #ff00cc;
    border-radius:30px;
    background:#222;
    color:#fff;
    font-size:16px;
    cursor:pointer;
}

.platform-button.active,
.platform-button:hover {
    background:linear-gradient(45deg,#ff00cc,#00ccff);
}

.search-panel {
    display:none;
    margin:20px 0;
    padding:18px;
    background:rgba(255,255,255,.05);
    border-radius:15px;
}

.search-panel h3 {
    margin-top:0;
}

.search-row {
    display:flex;
    gap:10px;
}

.search-row input {
    flex:1;
    min-width:0;
    padding:12px 15px;
    border:1px solid rgba(255,0,204,.5);
    border-radius:25px;
    background:#111;
    color:#fff;
    font-size:16px;
    outline:none;
}

.search-row button {
    padding:12px 20px;
    border:0;
    border-radius:25px;
    background:#ff00cc;
    color:#fff;
    cursor:pointer;
}

.model-result {
    display:none;
    margin-top:25px;
}

.model-hero {
    position:relative;
    min-height:390px;
    border-radius:20px;
    overflow:hidden;
    background:
        linear-gradient(to bottom,rgba(0,0,0,.1),rgba(0,0,0,.95)),
        url("images/Icon.png") center/cover no-repeat;
    box-shadow:0 0 25px #ff00cc;
    display:flex;
    align-items:flex-end;
    text-align:left;
}

.model-overlay {
    width:100%;
    padding:25px 20px 20px;
    background:linear-gradient(transparent,rgba(0,0,0,.95));
}

.result-platform {
    color:#ff00cc;
    font-size:13px;
    font-weight:bold;
    text-transform:uppercase;
    letter-spacing:1px;
}

.model-overlay h2 {
    margin:6px 0;
    font-size:24px;
}

.result-id {
    color:rgba(255,255,255,.7);
    font-size:14px;
}

.rating-card {
    width:100%;
    margin-top:15px;
    padding:16px;
    border:0;
    border-radius:15px;
    color:#fff;
    font-size:20px;
    font-weight:bold;
    background:#888;
}

.rating-card.high {
    background:#18e35b;
}

.rating-card.medium {
    background:#72b77a;
}

.rating-card.low {
    background:#a1a7a3;
}

.rating-card.none {
    background:#666;
}

.experiences {
    margin-top:35px;
}

.experiences h3,
.latest-ratings h2 {
    color:rgba(255,255,255,.9);
}

.empty-experience {
    padding:18px;
    border-radius:15px;
    background:rgba(255,255,255,.05);
    color:rgba(255,255,255,.65);
}

.rate-button {
    width:100%;
    margin-top:15px;
    padding:13px;
    border:1px solid #ff00cc;
    border-radius:30px;
    background:linear-gradient(45deg,#ff00cc,#00ccff);
    color:#fff;
    font-size:16px;
    cursor:pointer;
}

.latest-ratings {
    margin-top:45px;
}

.rating-gallery {
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:12px;
}

.rating-tab {
    overflow:hidden;
    padding:0;
    border:1px solid rgba(255,0,204,.3);
    border-radius:15px;
    background:rgba(255,255,255,.05);
    color:#fff;
    text-align:left;
    cursor:pointer;
}

.rating-tab:hover {
    box-shadow:0 0 15px #ff00cc;
    transform:translateY(-2px);
}

.rating-tab img {
    width:100%;
    height:145px;
    object-fit:cover;
    display:block;
}

.rating-tab-info {
    padding:10px;
}

.rating-tab-platform {
    color:#ff00cc;
    font-size:11px;
    font-weight:bold;
    text-transform:uppercase;
}

.rating-tab-name {
    margin:4px 0;
    font-size:15px;
    font-weight:bold;
}

.rating-tab-id {
    color:rgba(255,255,255,.6);
    font-size:12px;
}

.rating-tab-score {
    margin-top:7px;
    font-size:14px;
    font-weight:bold;
}

.no-ratings {
    display:none;
    padding:20px;
    color:rgba(255,255,255,.65);
}

@media(max-width:420px) {
    .rating-gallery {
        gap:8px;
    }

    .rating-tab img {
        height:125px;
    }

    .search-row {
        flex-direction:column;
    }

    .search-row button {
        width:100%;
    }
}
