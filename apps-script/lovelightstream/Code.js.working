// =====================================================
// LOVE LIGHT STREAM — RATING DATABASE SETUP
// =====================================================

function setupRatingDatabase() {
  const spreadsheetId =
    PropertiesService.getScriptProperties().getProperty("SPREADSHEET_ID");

  if (!spreadsheetId) {
    throw new Error("Database not initialized.");
  }

  const spreadsheet = SpreadsheetApp.openById(spreadsheetId);

  // Add private Public Label column to Users sheet
  const usersSheet = spreadsheet.getSheetByName("Users");

  if (usersSheet) {
    const lastColumn = usersSheet.getLastColumn();
    const headers = usersSheet
      .getRange(1, 1, 1, lastColumn)
      .getValues()[0]
      .map(String);

    if (!headers.includes("Public Label")) {
      usersSheet.getRange(1, lastColumn + 1).setValue("Public Label");
    }
  }

  // Create Ratings sheet if it doesn't exist
  let ratingsSheet = spreadsheet.getSheetByName("Ratings");

  if (!ratingsSheet) {
    ratingsSheet = spreadsheet.insertSheet("Ratings");

    ratingsSheet.appendRow([
      "Rating ID",
      "Platform",
      "Model ID",
      "Model Name",
      "Rating",
      "Experience",
      "Date/Time",
      "User ID",
      "Public Label",
      "Verification",
      "Status",
      "Admin Note"
    ]);
  }

  Logger.log("Rating database is ready.");
  Logger.log("Ratings sheet: " + ratingsSheet.getName());
}

// =====================================================
// LOVE LIGHT STREAM — ANONYMOUS PUBLIC LABELS
// =====================================================

function getOrCreatePublicLabel(userId) {
  const user = findUserByUserId(userId);

  if (!user) {
    return {
      success: false,
      error: "User not found."
    };
  }

  // Display Name is public; email remains private.
  const publicLabel = String(user.name || "").trim();

  if (!publicLabel) {
    return {
      success: false,
      error: "Display Name is missing."
    };
  }

  // Preserve the existing Public Label column for compatibility.
  const sheet = getUsersSheet();
  const data = sheet.getDataRange().getValues();

  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]).trim().toLowerCase() ===
        String(userId).trim().toLowerCase()) {
      sheet.getRange(i + 1, 8).setValue(publicLabel);
      break;
    }
  }

  return {
    success: true,
    userId: user.userId,
    publicLabel: publicLabel
  };
}
function testPublicLabel() {
  const result = getOrCreatePublicLabel("LLS1001");
  Logger.log(JSON.stringify(result));
}

// =====================================================
// LOVE LIGHT STREAM — DUPLICATE RATING CHECK
// =====================================================

function checkExistingRating(userId, platform, modelId) {
  const spreadsheetId =
    PropertiesService.getScriptProperties().getProperty("SPREADSHEET_ID");

  if (!spreadsheetId) {
    throw new Error("Database not initialized.");
  }

  const spreadsheet = SpreadsheetApp.openById(spreadsheetId);
  const sheet = spreadsheet.getSheetByName("Ratings");

  if (!sheet) {
    return {
      exists: false
    };
  }

  const data = sheet.getDataRange().getValues();

  const normalizedPlatform = String(platform || "").trim().toLowerCase();
  const normalizedModelId = String(modelId || "").trim().toLowerCase();
  const normalizedUserId = String(userId || "").trim().toLowerCase();

  for (let i = 1; i < data.length; i++) {
    const rowUserId = String(data[i][7] || "").trim().toLowerCase();
    const rowPlatform = String(data[i][1] || "").trim().toLowerCase();
    const rowModelId = String(data[i][2] || "").trim().toLowerCase();

    if (
      rowUserId === normalizedUserId &&
      rowPlatform === normalizedPlatform &&
      rowModelId === normalizedModelId
    ) {
      return {
        exists: true,
        ratingId: data[i][0],
        message: "You have already rated this model on this platform."
      };
    }
  }

  return {
    exists: false
  };
}

function testDuplicateRatingCheck() {
  const result = checkExistingRating(
    "LLS1001",
    "eLive",
    "1234"
  );

  Logger.log(JSON.stringify(result));
}

// =====================================================
// LOVE LIGHT STREAM — SUBMIT RATING
// =====================================================

function submitRating(userId, platform, modelId, modelName, rating, experience) {

  userId = String(userId || "").trim();
  platform = String(platform || "").trim();
  modelId = String(modelId || "").trim();
  modelName = String(modelName || "").trim();
  experience = String(experience || "").trim();

  const numericRating = Number(rating);

  // Basic validation
  if (!userId) {
    return {
      success: false,
      error: "User ID is required."
    };
  }

  if (!platform) {
    return {
      success: false,
      error: "Platform is required."
    };
  }

  if (!modelId) {
    return {
      success: false,
      error: "Model ID is required."
    };
  }

  if (!Number.isFinite(numericRating) ||
      numericRating < 1 ||
      numericRating > 5) {
    return {
      success: false,
      error: "Rating must be between 1 and 5."
    };
  }

  // Only approved platforms
  const normalizedPlatform = platform.toLowerCase();

  if (
    normalizedPlatform !== "elive" &&
    normalizedPlatform !== "tango"
  ) {
    return {
      success: false,
      error: "Unsupported platform."
    };
  }

  // Verify user
  const user = findUserByUserId(userId);

  if (!user) {
    return {
      success: false,
      error: "User not found."
    };
  }

  if (user.verified !== true) {
    return {
      success: false,
      error: "Account is not verified."
    };
  }

  // Prevent simultaneous duplicate submissions
  const lock = LockService.getScriptLock();

  try {
    lock.waitLock(10000);

    // Check duplicate rating
    const duplicate = checkExistingRating(
      userId,
      platform,
      modelId
    );

    if (duplicate.exists) {
      return {
        success: false,
        error: duplicate.message,
        ratingId: duplicate.ratingId
      };
    }

    // Get anonymous public label
    const publicLabelResult = getOrCreatePublicLabel(userId);

    if (!publicLabelResult.success) {
      return {
        success: false,
        error: publicLabelResult.error
      };
    }

    const spreadsheetId =
      PropertiesService.getScriptProperties()
        .getProperty("SPREADSHEET_ID");

    const spreadsheet =
      SpreadsheetApp.openById(spreadsheetId);

    const sheet =
      spreadsheet.getSheetByName("Ratings");

    if (!sheet) {
      return {
        success: false,
        error: "Ratings database is not available."
      };
    }

    // Generate Rating ID
    const timestamp = new Date().getTime();

    const randomPart = Math.floor(
      1000 + Math.random() * 9000
    );

    const ratingId =
      "R" + timestamp + randomPart;

    const now = new Date();

    // Save rating
    sheet.appendRow([
      ratingId,
      platform,
      modelId,
      modelName,
      numericRating,
      experience,
      now,
      userId,
      publicLabelResult.publicLabel,
      "Verified User",
      "New",
      ""
    ]);

    return {
      success: true,
      ratingId: ratingId,
      platform: platform,
      modelId: modelId,
      rating: numericRating,
      publicLabel: publicLabelResult.publicLabel,
      message: "Rating submitted successfully."
    };

  } finally {
    lock.releaseLock();
  }
}

// =====================================================
// FIND USER BY USER ID
// =====================================================

function findUserByUserId(userId) {

  const sheet = getUsersSheet();
  const data = sheet.getDataRange().getValues();

  const normalizedUserId =
    String(userId || "").trim().toLowerCase();

  if (!normalizedUserId) {
    return null;
  }

  for (let i = 1; i < data.length; i++) {

    const rowUserId =
      String(data[i][0] || "").trim().toLowerCase();

    if (rowUserId === normalizedUserId) {

      return {
        row: i + 1,
        userId: data[i][0],
        email: data[i][1],
        name: data[i][2],
        pin: data[i][3],
        verified: data[i][4],
        createdAt: data[i][5],
        lastLogin: data[i][6],
        publicLabel: data[i][7]
      };
    }
  }

  return null;
}

function testSubmitRating() {
  const result = submitRating(
    "LLS1001",
    "eLive",
    "1234",
    "Test Model",
    4.5,
    "This is a test community experience."
  );

  Logger.log(JSON.stringify(result));
}

function testDuplicateSubmission() {
  const result = submitRating(
    "LLS1001",
    "eLive",
    "1234",
    "Test Model",
    5,
    "This should be rejected as a duplicate."
  );

  Logger.log(JSON.stringify(result));
}
// =====================================================
// LOVE LIGHT STREAM — PUBLIC RATINGS READER
// =====================================================

function getPublicRatings(platform, modelId) {

  platform = String(platform || "").trim();
  modelId = String(modelId || "").trim();

  const spreadsheetId =
    PropertiesService.getScriptProperties()
      .getProperty("SPREADSHEET_ID");

  if (!spreadsheetId) {
    throw new Error("Database not initialized.");
  }

  const spreadsheet =
    SpreadsheetApp.openById(spreadsheetId);

  const sheet =
    spreadsheet.getSheetByName("Ratings");

  if (!sheet) {
    return {
      success: true,
      ratings: []
    };
  }

  const data = sheet.getDataRange().getValues();

  const normalizedPlatform =
    platform.toLowerCase();

  const normalizedModelId =
    modelId.toLowerCase();

  const publicRatings = [];

  for (let i = 1; i < data.length; i++) {

    const rowPlatform =
      String(data[i][1] || "").trim();

    const rowModelId =
      String(data[i][2] || "").trim();

    const status =
      String(data[i][10] || "").trim();

    // Never expose rejected ratings
    if (status.toLowerCase() === "rejected") {
      continue;
    }

    // Platform filter
    if (
      normalizedPlatform &&
      rowPlatform.toLowerCase() !== normalizedPlatform
    ) {
      continue;
    }

    // Model ID filter
    if (
      normalizedModelId &&
      rowModelId.toLowerCase() !== normalizedModelId
    ) {
      continue;
    }

    const dateValue = data[i][6];

    let date = "";

    if (dateValue instanceof Date) {
      date = dateValue.toISOString();
    } else if (dateValue) {
      date = String(dateValue);
    }

    // IMPORTANT:
    // Only public-safe fields are returned.
    publicRatings.push({
      platform: rowPlatform,
      modelId: rowModelId,
      modelName: String(data[i][3] || ""),
      rating: Number(data[i][4] || 0),
      experience: String(data[i][5] || ""),
      date: date,
      publicLabel: String(data[i][8] || "Anonymous")
    });
  }
return {
    success: true,
    ratings: publicRatings
};
}

// ============================================================
// LOVE LIGHT STREAM — SUGGESTIONS DATABASE
// ============================================================

function setupSuggestionsDatabase() {

  const spreadsheetId =
    PropertiesService.getScriptProperties().getProperty("SPREADSHEET_ID");

  if (!spreadsheetId) {
    throw new Error("Database not initialized.");
  }

  const spreadsheet = SpreadsheetApp.openById(spreadsheetId);

  let suggestionsSheet =
    spreadsheet.getSheetByName("Suggestions");

  if (!suggestionsSheet) {

    suggestionsSheet =
      spreadsheet.insertSheet("Suggestions");

    suggestionsSheet.appendRow([
      "App Name",
      "Suggestion",
      "Date/Time",
      "Status"
    ]);
  }

  Logger.log("Suggestions database is ready.");
  Logger.log(
    "Suggestions sheet: " + suggestionsSheet.getName()
  );
}

function testPublicRatings() {

  const result = getPublicRatings(
    "eLive",
    "1234"
  );

  Logger.log(JSON.stringify(result));
}

// =====================================================
// LOVE LIGHT STREAM — APP SUGGESTIONS
// =====================================================

function submitSuggestion(appName, suggestion) {

  appName = String(appName || "").trim();
  suggestion = String(suggestion || "").trim();

  if (!appName) {
    return {
      success: false,
      error: "App name is required."
    };
  }

  const spreadsheetId =
    PropertiesService.getScriptProperties().getProperty("SPREADSHEET_ID");

  if (!spreadsheetId) {
    throw new Error("Database not initialized.");
  }

  const spreadsheet = SpreadsheetApp.openById(spreadsheetId);

  let sheet = spreadsheet.getSheetByName("Suggestions");

  if (!sheet) {
    sheet = spreadsheet.insertSheet("Suggestions");

    sheet.appendRow([
      "App Name",
      "Suggestion",
      "Date/Time",
      "Status"
    ]);
  }

  const now = new Date();

  sheet.appendRow([
    appName,
    suggestion,
    now,
    "New"
  ]);

  MailApp.sendEmail({
    to: "lovelightstream@gmail.com",
    subject: "New Love Light Stream App Suggestion",
    body:
      "A new app suggestion was submitted.\n\n" +
      "App Name: " + appName + "\n" +
      "Suggestion: " + (suggestion || "No suggestion provided") + "\n" +
      "Date/Time: " + now.toLocaleString()
  });

  return {
    success: true,
    message: "Suggestion submitted successfully."
  };
}

